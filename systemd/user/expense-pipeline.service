[Unit]
Description=Expense Pipeline Local Web App
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/yaloalo/projects/inprogress/expenses
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=5173
Environment=DB_BACKEND=sqlite
Environment=SQLITE_PATH=/home/yaloalo/projects/inprogress/expenses/data/expenses.sqlite
ExecStart=/usr/bin/node /home/yaloalo/projects/inprogress/expenses/build/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
